{
  "id": "cf-03",
  "question": "Show me high-margin, low-debt companies that have sold off hard recently and are now oversold — RSI below 30.",
  "tools_called": [
    {
      "tool": "find_fsconcept",
      "args": {
        "queries": [
          "net income",
          "revenue",
          "revenue growth",
          "P/E ratio",
          "net margin",
          "debt to equity",
          "return on equity",
          "free cash flow yield",
          "dividend yield",
          "dividend growth",
          "earnings growth"
        ]
      },
      "note": "batch resolver run once for the whole set"
    },
    {
      "tool": "find_fspattern",
      "args": {
        "queries": [
          "profitable / positive",
          "revenue growing over 20% a year",
          "P/E below 15",
          "above a threshold",
          "below a threshold",
          "high margin",
          "low debt",
          "dividend yield above 4%",
          "dividend growing / raising payout",
          "earnings growing",
          "margins expanding",
          "still growing revenue"
        ]
      },
      "note": "batch resolver run once for the whole set"
    },
    {
      "tool": "find_tasignal",
      "args": {
        "q": [
          "just broke out above the 50-day moving average",
          "price above the 200-day moving average",
          "RSI below 30 oversold after a selloff",
          "price in an uptrend above the 200-day moving average",
          "dropped more than 25% from its 52-week high",
          "coming out of a volatility squeeze and starting to move up",
          "bullish MACD crossover",
          "down 30% and RSI reset below 40",
          "reclaimed the 50-day moving average after a dip",
          "bullish divergence on the daily chart"
        ]
      },
      "note": "batch resolver run once for the whole set"
    },
    {
      "tool": "find_gics",
      "args": {
        "q": "healthcare sector"
      },
      "note": "cf-07 -> code 35"
    },
    {
      "tool": "find_gics",
      "args": {
        "q": "technology sector"
      },
      "note": "cf-05 -> code 45"
    },
    {
      "tool": "screen_unified",
      "args": {
        "fundamental": [
          {
            "concept": "net_margin",
            "pattern": "high"
          },
          {
            "concept": "debt_to_equity",
            "pattern": "low"
          }
        ],
        "ta": [
          {
            "anchor": [
              {
                "pattern": "oversold",
                "a": "rsi"
              }
            ]
          }
        ],
        "asset_type": [
          "Common Stock"
        ],
        "timeframe": 1,
        "window_bars": 20,
        "limit": 10
      }
    }
  ],
