{
  "id": "cf-02",
  "question": "I want cheap stocks — low P/E, under 15 — that are still trading above their 200-day moving average. US large caps only.",
  "tools_called": [
    {
      "tool": "find_fsconcept",
      "args": {
        "queries": [
          "net income",
          "revenue",
          "revenue growth",
          "P/E ratio",
          "net margin",
          "debt to equity",
          "return on equity",
