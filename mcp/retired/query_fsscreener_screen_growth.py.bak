# RETIRED $(date +%Y-%m-%d) — superseded by screen_unified (marketdx unified-screener-mcp).
# The standalone HTTP endpoints (/v1/financials/screen, /v1/financials/screen-growth) are UNCHANGED;
# only these MCP tool wrappers were removed. Restore = paste back into server.py (ScreenCondition + _cond_to_api still live there).

# ─────────── screen_growth ───────────
@mcp.tool(name="screen_growth", title="Screen by Growth Pattern", annotations=_RO)
def screen_growth(
        concept: Annotated[str, _dq(
            "A growth CONCEPT_KEY (from find_fsconcept, type:'growth') — one of: 'consecutive_growth' (grew above a "
            "threshold EVERY year for N years), 'compound_growth' (CAGR over N years — the AVERAGE, not every year), "
            "'decelerating' / 'accelerating' (growth-rate slowing / speeding up — the 2nd derivative), "
            "'decline_bottoming' (contraction easing) / 'decline_accelerating' (shrinking faster), 'stable_growth', "
            "'erratic_growth', 'growth_turned_negative', 'latest_yoy', 'qoq_momentum', 'profitless_growth'.")],
        metric: Annotated[Optional[str], _d(
            "The field/ratio to measure — a concept (resolve via find_fsconcept if unsure). Default "
            "'revenue'. Works on LEVELS and RATIOS: 'net_income', 'free_cash_flow', 'net_margin', 'roe', 'capex_to_da'.")] = None,
        n: Annotated[Optional[int], _d(
            "The window/streak parameter the concept needs: YEARS for consecutive_growth/compound_growth (2/3/4/5), "
            "or the minimum CONSECUTIVE PERIODS for decelerating/accelerating/decline_accelerating.")] = None,
        threshold: Annotated[Optional[float], _d(
            "The growth threshold as a FRACTION (0.10 = 10%). consecutive_growth: every year must exceed it; "
            "compound_growth: the CAGR must; latest_yoy/qoq_momentum: the latest reading must.")] = None,
        basis: Annotated[Optional[str], _d(
            "OPTIONAL basis: 'A' annual (default for multi-year patterns), 'Q' quarterly YoY (timeliest, default for "
            "the 2nd-derivative quadrants), 'T' rolling-TTM.")] = None,
        limit: Annotated[Optional[int], _d("Max stocks (default 50, max 200).")] = None) -> dict:
    """EXECUTE a growth screen resolved from find_fsconcept (a candidate with type:'growth'). Growth concepts are
    PARAMETRIC — you FILL the params you extracted from the question; the server builds the query deterministically.
    Routing: 'grew >10% EVERY year for 3y' → concept='consecutive_growth', metric='revenue', n=3, threshold=0.10;
    'grew ~10% ON AVERAGE over 5y' → concept='compound_growth', n=5, threshold=0.10; 'which companies are slowing
    down' → concept='decelerating', basis='Q'. Returns {count, stocks:[{head_listing_id, ticker, name}]}. NOTE:
    coverage grows as the fundamentals mart fills — the quarterly/TTM 2nd-derivative needs ~7+ quarters of history."""
    params = {"concept": concept, "metric": metric or "revenue", "limit": _lim(limit, default=50, ceiling=200)}
    if n is not None:
        params["N"] = n
    if threshold is not None:
        params["threshold"] = threshold
    if basis:
        params["basis"] = basis
    return mdx()._get("/v1/financials/screen-growth", params).data

# ─────────── query_fsscreener ───────────
@mcp.tool(name="query_fsscreener", title="Screen Stocks by Financial Conditions", annotations=_RO)
def query_fsscreener(
        conditions: Annotated[List[ScreenCondition], _d(
            "AND-ed conditions (INTERSECT). Build each from find_fsconcept (→ `concept`) + find_fspattern (→ "
            "`pattern`), then its value. e.g. roe>20% & low debt → [{concept:'roe',pattern:'above',threshold:0.20}, "
            "{concept:'debt_to_equity',pattern:'below',threshold:0.5}]; P/E below market avg → "
            "[{concept:'pe',pattern:'below_average'}]; cheapest 10% by P/E → [{concept:'pe',pattern:'low',percentile:0.1}].")],
        gics: Annotated[Optional[str], _d(
            "OPTIONAL sector scope — a GICS code prefix from find_gics ('45'=IT, '4530'=semis). Restricts the screen "
            "to that sector. (Same as putting it in `filters.gics`; either works.)")] = None,
        country: Annotated[Optional[str], _d("OPTIONAL ISO-2 issuer-domicile scope ('US','CN','TH') — restrict to that country.")] = None,
        size: Annotated[Optional[str], _d("OPTIONAL size tier ('large'|'mid'|'small'|'micro') — e.g. exclude micro-caps.")] = None,
        min_market_cap_usd: Annotated[Optional[float], _d("OPTIONAL min market cap in USD (e.g. 50000000000 = $50bn) — cut small-cap noise.")] = None,
        max_market_cap_usd: Annotated[Optional[float], _d("OPTIONAL max market cap in USD — e.g. cap the screen at mid-caps.")] = None,
        filters: Annotated[Optional[dict], _d(
            "OPTIONAL extra PRE-filters as a dict: {'region':'EU', 'theme':'<megatrend id>'}. "
            "(gics/country/size/min_market_cap_usd are also top-level args above — use whichever is convenient.)")] = None,
        sort_by: Annotated[Optional[str], _d(
            "OPTIONAL metric to RANK results by (direction auto from the ratio's better-is-high/low). Default = market cap.")] = None,
        limit: Annotated[Optional[int], _d("Max stocks (default 50).")] = None) -> dict:
    """EXECUTE a multi-condition FUNDAMENTALS screen — the answer to 'find stocks where <metric> is <shape> AND …'.
    🔴 This is the ONLY tool that filters by MARGINS, RETURNS (ROE/ROIC), VALUATION-vs-PEERS, GROWTH SHAPES, or a
    metric RELATION — `screen_stocks` does valuation LEVELS only, `screen_growth` is a single growth pattern.
    ⭐ "below / above / cheaper-than / richer-than the SECTOR or PEER AVERAGE" (undervalued-vs-peers, "P/E below its
    group", "margin above the industry") → THIS tool, pattern `below_average`/`above_average` — the benchmark is a
    proper cap-weighted, FULL-universe, outlier-cleaned cohort average computed server-side. Do NOT instead pull a
    handful of names from `screen_stocks` and average them yourself — that sample is partial, unweighted, and dirty.
    Compose
    `conditions` from find_fsconcept (metric) + find_fspattern (shape); the server resolves Field Polarity and
    INTERSECTs them. Returns {count, conditions:[resolution trace incl `cohort_benchmark` (the actual peer-average value
    for below_average/above_average — quote it, don't recompute) + `eligible` coverage], stocks:[{ticker, name, metrics}]}.
    🚩 A VALUATION screen adds `metrics.earnings_quality_ocf_ni` per stock = operating-cash ÷ net-income: if it's ≪1 or
    NEGATIVE, a low P/E is likely ONE-OFF / non-cash earnings (holding-co mark-to-market, crypto revaluation) — REAL data
    but not recurring, so it's "cheap for the wrong reason", NOT genuinely undervalued → say so, don't headline it as cheap.
    (Caveat: for BANKS / INSURERS this ratio is naturally high/erratic — their operating cash flow isn't comparable to an
    industrial's; don't read a high value there as quality. A trailing-12-month LOSS-maker has NO P/E → the field is null.)
    count=0 → read conditions[].eligible: 0 = metric not populated (data-depth), >0 = data exists but nothing matched
    (loosen the threshold / cohort)."""
    # fold the top-level scope args into `filters` (screen_stocks-style convenience — the LLM naturally reaches for a
    # bare `gics=`; put it wherever, it lands in the same pre-filter).
    f = dict(filters or {})
    # top-level scope args fold into `filters`. min/max_market_cap_usd map to the news-api filter keys market_cap_min/max
    # (prefix naming here matches every other tool — screen_dividends' min_market_cap_usd, positioning, etc.).
    for k, v in (("gics", gics), ("country", country), ("size", size),
                 ("market_cap_min", min_market_cap_usd), ("market_cap_max", max_market_cap_usd)):
        if v is not None:
            f[k] = v
    # a cohort pattern (below_average/above_average/…) with NO explicit vs_cohort → default the BENCHMARK peer group to
    # the same scope you're screening, so "banks above average" means above the BANK average, not the whole-market
    # average (the scope only filtered WHICH rows come back, it didn't set the benchmark). Explicit vs_cohort still wins.
    scope_cohort = {}
    if gics and str(gics).isdigit(): scope_cohort["gics"] = gics
    if country and len(str(country)) == 2 and str(country).isalpha(): scope_cohort["country"] = str(country).upper()
    if size: scope_cohort["size"] = [size]
    if scope_cohort:
        for c in conditions:
            if c.pattern and "average" in c.pattern and not c.vs_cohort:
                c.vs_cohort = dict(scope_cohort)
    params = {"conditions": json.dumps([_cond_to_api(c) for c in conditions]), "limit": _lim(limit, default=50, ceiling=5000)}
    if f:
        params["filters"] = json.dumps(f)
    if sort_by:
        params["sort_by"] = sort_by
    return mdx()._get("/v1/financials/screen", params).data
